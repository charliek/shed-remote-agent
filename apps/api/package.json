{
  "name": "api",
  "version": "0.1.0",
  "description": "Backend API for shed-remote-agent",
  "main": "src/index.ts",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist --target bun",
    "start": "bun run dist/index.js",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "lint": "biome check .",
    "lint:fix": "biome check --write ."
  },
  "dependencies": {
    "@shed-remote-agent/shared": "workspace:*",
    "hono": "^4.6.0",
    "pino": "^9.5.0",
    "pino-pretty": "^11.2.0",
    "yaml": "^2.6.0",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/bun": "latest"
  }
}
