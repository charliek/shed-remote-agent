PORT=8787
HOST=0.0.0.0
NODE_ENV=development
LOG_LEVEL=info

# CORS origins for the frontend (comma-separated)
CORS_ORIGINS=http://localhost:5173

# Path to the shed CLI's config file (defaults to ~/.shed/config.yaml)
# SHED_CONFIG_PATH=/home/you/.shed/config.yaml

# Path to our own config file (defaults to ~/.config/shed-remote-agent/config.yaml)
# APP_CONFIG_PATH=/home/you/.config/shed-remote-agent/config.yaml
