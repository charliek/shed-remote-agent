# shed-remote-agent API environment.
#
# Bun loads this file automatically on startup (no explicit dotenv import
# needed — see https://bun.sh/docs/runtime/env). Copy this file to
# `apps/api/.env` (gitignored) and adjust per-machine.

# --- listen address ---
HOST=0.0.0.0
PORT=8787

# --- logging ---
NODE_ENV=development
LOG_LEVEL=info

# --- origin allowlist ---
# Comma-separated list of full origins. Used by:
#   1. The HTTP CORS middleware (any cross-origin browser fetch).
#   2. The WebSocket `/api/sheds/.../attach` upgrade — browser WebSockets
#      bypass same-origin policy, so an explicit allowlist is the only
#      defense against cross-site WS hijacking. A request whose `Origin`
#      header is set and not present here is rejected with 403.
#
# Include every origin the page is actually served from. Examples:
#   - localhost only:        http://localhost:5173
#   - with devproxy/tailnet: http://localhost:5173,https://sra.local.stridelabs.ai
CORS_ORIGINS=http://localhost:5173,https://sra.local.stridelabs.ai

# --- config file paths (defaults shown commented) ---
# SHED_CONFIG_PATH=~/.shed/config.yaml
# APP_CONFIG_PATH=~/.config/shed-remote-agent/config.yaml
